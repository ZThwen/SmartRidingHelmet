/* login.wxss — 白色主题登录页 */

page {
  background: #ffffff;
  height: 100%;
}

.stage-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  position: relative;
  background: #ffffff;
}

/* 顶部微弱渐变 */
.stage-container::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 40vh;
  background: radial-gradient(ellipse at 50% 0%, rgba(102, 204, 255, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.content-wrap {
  width: 100%;
  max-width: 600rpx;
  position: relative;
  z-index: 1;
}

/* 标题 */
.title-block {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a2e;
  letter-spacing: 4rpx;
}

.deco-wave {
  font-size: 28rpx;
  color: rgba(102, 204, 255, 0.6);
  line-height: 1;
}

/* 分隔线 */
.divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #66ccff, transparent);
  margin: 0 auto 80rpx;
  opacity: 0.6;
}

/* 输入框 */
.input-wrap {
  margin-bottom: 60rpx;
}

.cyan-input {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e2e8f0;
  margin-bottom: 24rpx;
  transition: border-color 0.3s ease;
  position: relative;
}

.cyan-input:focus-within {
  border-bottom-color: #66ccff;
}

/* 聚焦时底部发光条 */
.cyan-input::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  width: 0;
  height: 2rpx;
  background: #66ccff;
  box-shadow: 0 0 8rpx rgba(102, 204, 255, 0.4);
  transition: all 0.3s ease;
  transform: translateX(-50%);
}

.cyan-input:focus-within::after {
  width: 100%;
}

.input-icon {
  font-size: 28rpx;
  color: rgba(102, 204, 255, 0.7);
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.cyan-input input {
  flex: 1;
  height: 48rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  background: transparent;
  caret-color: #66ccff;
}

.ph {
  color: #9aa8b5;
  font-size: 30rpx;
}

/* 主按钮 */
.btn-cyan {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #66ccff, #80d4ff);
  box-shadow: 0 4rpx 16rpx rgba(102, 204, 255, 0.3);
}

.btn-cyan .btn-text {
  position: relative;
  z-index: 2;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 8rpx;
}

.btn-cyan:active {
  background: linear-gradient(135deg, #4db8e6, #66ccff);
  box-shadow: 0 2rpx 8rpx rgba(102, 204, 255, 0.2);
  transform: scale(0.98);
}

/* 加载态 */
.btn-cyan.loading {
  opacity: 0.6;
}

/* 错误提示 */
.error-bar {
  margin-top: 32rpx;
  text-align: center;
}

.error-text {
  font-size: 26rpx;
  color: #e53e3e;
  display: inline-block;
  position: relative;
  padding-bottom: 8rpx;
}

.error-text::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: #e53e3e;
  opacity: 0.6;
}
