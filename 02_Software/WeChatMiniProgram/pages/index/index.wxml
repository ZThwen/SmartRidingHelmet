<!-- 智能骑行头盔 — 首页 (Tactical Cyan) -->
<canvas type="2d" id="dotCanvas" style="width:20px;height:20px;position:fixed;top:-100px;"></canvas>
<view class="page">

  <!-- 状态栏填充（fixed，覆盖刘海） -->
  <view class="status-fill" style="height: {{statusBarHeight}}px;"></view>

  <!-- 自定义导航栏（fixed，紧贴状态栏下方） -->
  <view class="nav-bar" style="top: {{statusBarHeight}}px;">
    <view class="nav-back" catchtap="onBackPress" hover-class="nav-back-hover">‹ 返回</view>
    <view class="nav-title">
      <text class="deco">≋</text>
      <text>智能骑行头盔</text>
      <text class="deco">≋</text>
    </view>
    <view class="nav-spacer"></view>
  </view>

  <!-- 内容起始位（状态栏 + 导航栏高度） -->
  <view style="height: calc({{statusBarHeight}}px + 88rpx);"></view>

  <!-- 地图区域 -->
  <view class="map-section">
    <view class="holo-frame">
      <map style="width:100%;height:{{mapHeight}}rpx;transition:height 0.3s"
        latitude="{{mapLat}}" longitude="{{mapLon}}"
        scale="{{mapExpanded ? 16 : 15}}" show-location="{{!riding}}"
        polyline="{{trackPolylines}}"
        markers="{{trackMarkers}}"
        bindregionchange="onMapRegionChange"
        bindtap="onMapTap">
      </map>
    </view>
    <view class="map-handle" bindtap="onToggleMap">
      <text>{{mapExpanded ? '▲ 收起' : '▼ 展开'}}</text>
    </view>
    <view class="map-reset {{mapFollowing ? 'hidden' : ''}}" catchtap="onMapReset">
      <text>⊙</text>
    </view>
  </view>

  <!-- 数据卡片区 -->
  <view class="content-scroll">

    <!-- BLE 连接状态 -->
    <view class="ble-status {{bleConnected ? 'connected' : ''}}">
      <view class="ble-dot {{bleConnected ? 'on' : 'off'}}"></view>
      <text class="ble-label">BLE: {{bleStatus}}</text>
      <button class="ble-btn" bindtap="onToggleBle">{{bleConnected ? '断开' : '连接'}}</button>
    </view>

    <!-- BLE 设备选择弹窗 -->
    <view class="ble-picker" wx:if="{{showBlePicker}}">
      <view class="picker-title">选择设备</view>
      <view class="picker-item" wx:for="{{bleDevices}}" wx:key="deviceId"
            data-device-id="{{item.deviceId}}" bindtap="onBleDevicePick">
        <text class="picker-name">{{item.name}}</text>
        <text class="picker-rssi">{{item.rssi}}dBm</text>
      </view>
      <button class="picker-cancel" bindtap="onBlePickerCancel">取消</button>
    </view>

    <!-- 玻璃状态栏 -->
    <view class="glass-status">
      <view class="status-left">
        <view class="status-dot {{isOnline ? 'online' : 'offline'}}"></view>
        <text class="status-text">{{status}}</text>
      </view>
      <text class="time-text" wx:if="{{time}}">更新 {{time}}</text>
    </view>

    <!-- 心率/血氧状态栏 -->
    <view class="heart-rate-bar">
      <view class="hr-icon-wrap {{heartClass}}">
        <text class="hr-icon">{{heartIcon}}</text>
      </view>
      <view class="hr-sep"></view>
      <view class="hr-value-wrap">
        <text class="hr-value {{heartClass}}">{{heartRate}}</text>
        <text class="hr-unit">bpm</text>
      </view>
      <view class="hr-sep"></view>
      <view class="spo2-value-wrap">
        <text class="spo2-value {{spo2Class}}">{{spo2}}</text>
        <text class="spo2-unit">SpO2</text>
      </view>
      <view class="hr-corners">
        <view class="hr-corner tl"></view><view class="hr-corner tr"></view>
        <view class="hr-corner bl"></view><view class="hr-corner br"></view>
      </view>
    </view>

    <!-- 环境卡片 -->
    <view class="tac-card">
      <view class="card-header">
        <text class="card-title">环境</text>
        <view class="deco-line"></view>
      </view>
      <view class="card-body">
        <view class="data-row"><text class="d-label">温度</text><text class="d-value">{{temp}}</text></view>
        <view class="data-row"><text class="d-label">湿度</text><text class="d-value">{{humid}}</text></view>
        <view class="data-row"><text class="d-label">速度</text><text class="d-value">{{speed}}</text></view>
        <view class="data-row"><text class="d-label">电量</text><text class="d-value">{{battery}}</text></view>
      </view>
      <view class="corner tl"></view><view class="corner tr"></view>
      <view class="corner bl"></view><view class="corner br"></view>
    </view>

    <view class="wave-divider"></view>

    <!-- 定位卡片 -->
    <view class="tac-card">
      <view class="card-header">
        <text class="card-title">定位</text>
        <view class="deco-line"></view>
      </view>
      <view class="card-body">
        <view class="data-row"><text class="d-label">纬度</text><text class="d-value">{{lat}}</text></view>
        <view class="data-row"><text class="d-label">经度</text><text class="d-value">{{lon}}</text></view>
        <view class="data-row"><text class="d-label">海拔</text><text class="d-value">{{alt}}</text></view>
      </view>
      <view class="corner tl"></view><view class="corner tr"></view>
      <view class="corner bl"></view><view class="corner br"></view>
    </view>

    <view class="wave-divider"></view>

    <!-- 状态卡片 -->
    <view class="tac-card">
      <view class="card-header">
        <text class="card-title">状态</text>
        <view class="deco-line"></view>
      </view>
      <view class="card-body">
        <view class="data-row"><text class="d-label">信号</text><text class="d-value">{{signal}}</text></view>
        <view class="data-row">
          <text class="d-label">报警</text>
          <view class="alarm-wrap">
            <view class="alarm-bar {{alarm !== '正常' && alarm !== '离线' && alarm !== '--' ? 'active' : ''}}"></view>
            <text class="d-value {{alarm !== '正常' && alarm !== '离线' && alarm !== '--' ? 'alarm-on' : ''}}">{{alarm}}</text>
          </view>
        </view>
      </view>
      <view class="corner tl"></view><view class="corner tr"></view>
      <view class="corner bl"></view><view class="corner br"></view>
    </view>

    <!-- 底部间距（避让 custom-tab-bar 按钮区 + tab 栏 = 约 220rpx） -->
    <view style="height:240rpx;"></view>
  </view>

  <!-- 报警全屏弹窗 -->
  <view class="alarm-popup {{alarmPopupClass}}" wx:if="{{showAlarmPopup}}">
    <!-- 脉冲边框 -->
    <view class="alarm-pulse-border"></view>

    <!-- 主报警内容 -->
    <view class="alarm-popup-body">
      <!-- 碰撞图标 -->
      <view class="alarm-icon-wrap">
        <view class="alarm-icon-ring"></view>
        <text class="alarm-icon">{{alarmPopupData.icon}}</text>
      </view>

      <!-- 报警类型 -->
      <text class="alarm-type">{{alarmPopupData.type}}</text>
      <text class="alarm-level">{{alarmPopupData.level}}</text>

      <!-- 分隔线 -->
      <view class="alarm-divider"></view>

      <!-- 关键数据 -->
      <view class="alarm-data-grid">
        <view class="alarm-data-item">
          <text class="alarm-data-value">{{speed}}</text>
          <text class="alarm-data-label">km/h</text>
        </view>
        <view class="alarm-data-sep"></view>
        <view class="alarm-data-item">
          <text class="alarm-data-value">{{lat}}</text>
          <text class="alarm-data-label">纬度</text>
        </view>
        <view class="alarm-data-sep"></view>
        <view class="alarm-data-item">
          <text class="alarm-data-value">{{lon}}</text>
          <text class="alarm-data-label">经度</text>
        </view>
      </view>

      <!-- 提示 -->
      <text class="alarm-hint">报警信息已自动上传至云端</text>

      <!-- 取消报警按钮 -->
      <view class="alarm-cancel-btn" bindtap="onCancelAlarm">
        <text>取消报警</text>
      </view>
    </view>
  </view>

  <!-- 目的地选择弹窗 -->
  <view class="nav-picker-mask" wx:if="{{showNavPicker}}">
    <view class="nav-picker">
      <view class="nav-picker-icon">
        <view class="nav-picker-icon-ring"></view>
        <text class="nav-picker-icon-text">⬡</text>
      </view>
      <text class="nav-picker-title">导航设置</text>
      <text class="nav-picker-desc">选择目的地后将自动规划骑行路线</text>
      <view class="nav-picker-btns">
        <button class="nav-picker-btn pick" bindtap="onPickDestination">
          <text class="nav-picker-btn-icon">◎</text> 设置目的地
        </button>
        <view class="nav-picker-or"><text>or</text></view>
        <button class="nav-picker-btn skip" bindtap="onSkipNavigation">直接出发</button>
      </view>
      <view class="nav-picker-cancel" bindtap="onCancelNavPicker">取消</view>
    </view>
  </view>

  <!-- 导航指令浮层（纯信息展示，取消导航已移至底部 TabBar） -->
  <view class="nav-card" wx:if="{{showNavCard}}">
    <view class="nav-card-top-line"></view>
    <view class="nav-card-body">
      <view class="nav-direction">
        <text class="nav-direction-text">{{navState === 'paused' ? '⚠' : '→'}}</text>
      </view>
      <view class="nav-info">
        <text class="nav-instruction">{{navInstruction}}</text>
        <view class="nav-remain-text">
          <view class="nav-road-dot"></view>
          <text>剩余 {{navRemainDistance}}m</text>
        </view>
      </view>
      <view class="nav-distance">
        <text class="nav-distance-value">{{navCurDistance}}</text>
        <text class="nav-distance-unit">m</text>
      </view>
    </view>
    <view class="nav-card-footer">
      <text class="nav-remain-detail">全程 {{navRemainDistance}}m</text>
      <text class="nav-status-hint">{{navState === 'paused' ? '⚠ 报警暂停中' : '▼ 底部取消导航'}}</text>
    </view>
  </view>

  <!-- 总结弹窗 -->
  <view class="modal-overlay" hidden="{{!showSummary}}">
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-deco"></view>
        <text class="modal-title">骑行总结</text>
      </view>
      <map
        latitude="{{_summaryMapLat}}"
        longitude="{{_summaryMapLon}}"
        scale="14"
        markers="{{_summaryMarkers}}"
        polyline="{{_summaryPolyline}}"
        style="width:100%;height:360rpx;border-radius:16rpx;overflow:hidden"
      ></map>
      <!-- 心率变化折线图 -->
      <view class="hr-chart-wrap" wx:if="{{summary.hrTimeSeries.length > 0}}">
        <text class="hr-chart-title">心率变化</text>
        <canvas type="2d" id="hrChart" style="width:620rpx;height:240rpx;"></canvas>
      </view>
      <view class="hr-chart-empty" wx:else>
        <text class="hr-chart-empty-text">暂无心率数据</text>
      </view>
      <view class="summary-table">
        <view class="row"><text class="lbl">总时长</text><text class="val">{{summary.duration}}</text></view>
        <view class="row"><text class="lbl">平均速度</text><text class="val">{{summary.avgSpeed}}</text></view>
        <view class="row"><text class="lbl">最高速度</text><text class="val">{{summary.maxSpeed}}</text></view>
        <view class="row"><text class="lbl">平均温度</text><text class="val">{{summary.avgTemp}}</text></view>
        <view class="row"><text class="lbl">最高温度</text><text class="val">{{summary.maxTemp}}</text></view>
        <view class="row"><text class="lbl">总里程</text><text class="val">{{summary.distance}}</text></view>
        <view class="row"><text class="lbl">平均心率</text><text class="val">{{summary.avgHeartRate}}</text></view>
        <view class="row"><text class="lbl">最高心率</text><text class="val">{{summary.maxHeartRate}}</text></view>
        <view class="row"><text class="lbl">平均血氧</text><text class="val">{{summary.avgSpO2}}</text></view>
        <view class="row"><text class="lbl">最低血氧</text><text class="val">{{summary.minSpO2}}</text></view>
        <view class="row"><text class="lbl">报警次数</text><text class="val">{{summary.alarmCount}}</text></view>
        <view class="row"><text class="lbl">采集点数</text><text class="val">{{summary.points}}</text></view>
      </view>
      <button class="close-btn" bindtap="onCloseSummary">
        <text>关闭</text>
        <view class="btn-fill"></view>
      </button>
    </view>
  </view>

  <custom-tab-bar></custom-tab-bar>

</view>
