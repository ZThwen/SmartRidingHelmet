/* index.wxss — 白色主题 + #66CCFF 主色调 */

page {
  background: #ffffff;
  color: #1a1a2e;
}

/* ===== 页面容器 ===== */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ===== 状态栏填充 ===== */
.status-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 98;
  background: #ffffff;
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  background: #ffffff;
  border-bottom: 1rpx solid #edf2f7;
}

.nav-back {
  font-size: 32rpx;
  color: #66ccff;
  padding: 12rpx 20rpx;
  min-width: 100rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-right: 140rpx;
}

.nav-title .deco {
  font-size: 22rpx;
  color: rgba(102, 204, 255, 0.5);
  line-height: 1;
}

/* ===== 地图区 ===== */
.map-section {
  position: relative;
  margin: 16rpx 20rpx;
}

.holo-frame {
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(102, 204, 255, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(102, 204, 255, 0.08);
}

.map-handle {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  z-index: 10;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(102, 204, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #66ccff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.map-reset {
  position: absolute;
  bottom: 16rpx;
  right: 140rpx;
  z-index: 10;
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(102, 204, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #66ccff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.map-reset.hidden {
  display: none;
}

/* ===== 滚动内容区 ===== */
.content-scroll {
  flex: 1;
  padding: 0 20rpx;
}

/* ===== BLE 状态栏 ===== */
.ble-status {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-bottom: 8rpx;
  background: #f5f8fb;
  border: 1rpx solid #edf2f7;
  border-radius: 12rpx;
}

.ble-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.ble-dot.on {
  background: #66ccff;
  box-shadow: 0 0 8rpx rgba(102, 204, 255, 0.5);
}

.ble-dot.off {
  background: #cbd5e0;
}

.ble-label {
  flex: 1;
  font-size: 24rpx;
  color: #6b7b8d;
}

.ble-btn {
  font-size: 22rpx;
  padding: 4rpx 20rpx;
  line-height: 1.8;
  border: 1rpx solid #66ccff;
  border-radius: 8rpx;
  background: transparent;
  color: #66ccff;
}

.ble-status.connected {
  border-color: rgba(102, 204, 255, 0.4);
}

/* ===== BLE 设备选择弹窗 ===== */
.ble-picker {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.picker-title {
  font-size: 24rpx;
  color: #9aa8b5;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 16rpx;
  margin-bottom: 8rpx;
  background: #f5f8fb;
  border: 1rpx solid #edf2f7;
  border-radius: 8rpx;
}

.picker-item:active {
  background: #edf2f7;
}

.picker-name {
  font-size: 26rpx;
  color: #1a1a2e;
}

.picker-rssi {
  font-size: 22rpx;
  color: #6b7b8d;
}

.picker-cancel {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa8b5;
  background: transparent;
  border: none;
  line-height: 2;
}

/* ===== 玻璃状态栏 ===== */
.glass-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background: #f5f8fb;
  border: 1rpx solid #edf2f7;
  border-radius: 12rpx;
}

.status-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #cbd5e0;
}

.status-dot.online {
  background: #38a169;
  box-shadow: 0 0 6rpx rgba(56, 161, 105, 0.4);
}

.status-dot.offline {
  background: #e53e3e;
  box-shadow: 0 0 6rpx rgba(229, 62, 62, 0.4);
}

.status-text {
  font-size: 26rpx;
  color: #6b7b8d;
}

.time-text {
  font-size: 22rpx;
  color: #9aa8b5;
}

/* ===== 战术卡片 ===== */
.tac-card {
  position: relative;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(102, 204, 255, 0.04);
}

/* 角标装饰 */
.corner {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(102, 204, 255, 0.5);
}

.corner.tl { top: 0; left: 0; border-top-left-radius: 16rpx; }
.corner.tr { top: 0; right: 0; border-top-right-radius: 16rpx; }
.corner.bl { bottom: 0; left: 0; border-bottom-left-radius: 16rpx; }
.corner.br { bottom: 0; right: 0; border-bottom-right-radius: 16rpx; }

.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #66ccff;
  letter-spacing: 2rpx;
}

.deco-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(102, 204, 255, 0.3), transparent);
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.d-label {
  font-size: 26rpx;
  color: #6b7b8d;
}

.d-value {
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.alarm-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.alarm-bar {
  width: 0;
  height: 24rpx;
  background: #e53e3e;
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.alarm-bar.active {
  width: 4rpx;
}

.alarm-on {
  color: #e53e3e;
  font-weight: 700;
}

/* ===== 底部按钮（已废弃，由 custom-tab-bar 接管）===== */
/* 保留以备兼容 */

/* ===== 报警全屏弹窗 ===== */
.alarm-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 998;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(200, 16, 16, 0.97) 0%, rgba(150, 0, 0, 0.98) 100%);
  overflow: hidden;
}

.alarm-popup.sos {
  animation: sos-blink 0.8s infinite;
}

@keyframes sos-blink {
  0%, 100% { background: linear-gradient(180deg, rgba(200, 16, 16, 0.97) 0%, rgba(150, 0, 0, 0.98) 100%); }
  50% { background: linear-gradient(180deg, rgba(230, 30, 30, 0.98) 0%, rgba(180, 10, 10, 1) 100%); }
}

/* 脉冲边框 */
.alarm-pulse-border {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border: 4rpx solid rgba(255, 80, 30, 0.6);
  animation: alarmPulseBorder 1.2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes alarmPulseBorder {
  0%, 100% { border-color: rgba(255, 80, 30, 0.6); box-shadow: inset 0 0 40rpx rgba(255, 80, 30, 0.1); }
  50% { border-color: rgba(255, 80, 30, 1); box-shadow: inset 0 0 80rpx rgba(255, 80, 30, 0.2); }
}

.alarm-popup-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  position: relative;
  z-index: 10;
}

/* 图标容器 */
.alarm-icon-wrap {
  width: 180rpx; height: 180rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.alarm-icon {
  font-size: 100rpx;
  position: relative;
  z-index: 2;
}

.alarm-icon-ring {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  animation: iconRingPulse 1.5s ease-in-out infinite;
}

@keyframes iconRingPulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.15); opacity: 0.1; }
}

.alarm-type {
  font-size: 52rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 0 40rpx rgba(255, 255, 255, 0.3);
}

.alarm-level {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffd700;
  letter-spacing: 8rpx;
  margin-bottom: 40rpx;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.4);
}

/* 分隔线 */
.alarm-divider {
  width: 200rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  margin-bottom: 40rpx;
}

/* 数据网格 */
.alarm-data-grid {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 24rpx 40rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 40rpx;
}

.alarm-data-item {
  text-align: center;
}

.alarm-data-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.alarm-data-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
  margin-top: 6rpx;
}

.alarm-data-sep {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.1);
}

.alarm-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 1rpx;
}

/* 取消报警按钮 */
.alarm-cancel-btn {
  margin-top: 40rpx;
  padding: 20rpx 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  text-align: center;
}

.alarm-cancel-btn text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

.alarm-cancel-btn:active {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
}

/* ===== 总结弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  width: 85%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 32rpx 28rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.modal-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.modal-deco {
  width: 4rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #66ccff, transparent);
  border-radius: 2rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.summary-table {
  width: 100%;
  margin-top: 20rpx;
}

.summary-table .row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.summary-table .row:last-child {
  border-bottom: none;
}

.summary-table .row .lbl { color: #6b7b8d; }
.summary-table .row .val {
  color: #1a1a2e;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.close-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 80rpx;
  border-radius: 12rpx;
  border: 2rpx solid #66ccff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: transparent;
}

.close-btn text {
  position: relative;
  z-index: 2;
  font-size: 28rpx;
  color: #66ccff;
  transition: color 0.3s ease;
}

.close-btn .btn-fill {
  position: absolute;
  top: 0; left: -100%;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, #66ccff, #80d4ff);
  z-index: 1;
  transition: left 0.3s ease;
}

.close-btn:active .btn-fill {
  left: 0;
}

.close-btn:active text {
  color: #ffffff;
}

/* ===== 目的地选择弹窗 ===== */
.nav-picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.nav-picker {
  width: 620rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

/* 弹窗顶部渐变线 */
.nav-picker::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #66ccff, #80d4ff, transparent);
}

.nav-picker-icon {
  width: 112rpx; height: 112rpx;
  margin: 0 auto 28rpx;
  background: rgba(102, 204, 255, 0.08);
  border: 1rpx solid rgba(102, 204, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-picker-icon-ring {
  position: absolute;
  top: -8rpx; left: -8rpx; right: -8rpx; bottom: -8rpx;
  border: 2rpx solid rgba(102, 204, 255, 0.12);
  border-radius: 50%;
  animation: pickerIconPulse 2.5s ease-in-out infinite;
}

@keyframes pickerIconPulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.12); opacity: 0.08; }
}

.nav-picker-icon-text {
  font-size: 44rpx;
  color: #66ccff;
  position: relative;
  z-index: 2;
}

.nav-picker-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.nav-picker-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7b8d;
  margin-bottom: 36rpx;
}

.nav-picker-btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.nav-picker-btn {
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  line-height: 1;
}

.nav-picker-btn.pick {
  background: linear-gradient(135deg, #66ccff, #80d4ff);
  border: none;
  color: #ffffff;
}

.nav-picker-btn.pick:active {
  background: linear-gradient(135deg, #4db8e6, #66ccff);
}

.nav-picker-btn-icon {
  font-size: 28rpx;
}

.nav-picker-or {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: -4rpx 0;
}

.nav-picker-or text {
  font-size: 22rpx;
  color: #9aa8b5;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.nav-picker-or::before,
.nav-picker-or::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e2e8f0;
}

.nav-picker-btn.skip {
  background: transparent;
  border: 1rpx solid #e2e8f0;
  color: #6b7b8d;
}

.nav-picker-btn.skip:active {
  background: #f5f8fb;
  color: #1a1a2e;
}

/* ===== 导航指令浮层 ===== */
.nav-card {
  position: fixed;
  bottom: 220rpx;
  left: 24rpx; right: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  overflow: hidden;
  z-index: 50;
  box-shadow: 0 4rpx 24rpx rgba(102, 204, 255, 0.12);
}

/* 顶部发光线条 */
.nav-card-top-line {
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #66ccff, transparent);
  opacity: 0.6;
}

.nav-card-body {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
}

.nav-direction {
  width: 80rpx; height: 80rpx;
  background: rgba(102, 204, 255, 0.08);
  border: 1rpx solid rgba(102, 204, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.nav-direction-text {
  font-size: 36rpx;
  color: #66ccff;
}

.nav-info {
  flex: 1;
  min-width: 0;
}

.nav-instruction {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 路名（带小圆点） */
.nav-remain-text {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #6b7b8d;
}

.nav-road-dot {
  width: 8rpx; height: 8rpx;
  background: rgba(102, 204, 255, 0.6);
  border-radius: 50%;
  flex-shrink: 0;
}

.nav-distance {
  text-align: right;
  flex-shrink: 0;
}

.nav-distance-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #66ccff;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.nav-distance-unit {
  display: block;
  font-size: 20rpx;
  color: #9aa8b5;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}

.nav-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #edf2f7;
  background: #f5f8fb;
}

.nav-remain-detail {
  font-size: 22rpx;
  color: #6b7b8d;
}

/* 导航状态提示（底部栏说明）*/
.nav-status-hint {
  font-size: 22rpx;
  color: #9aa8b5;
  letter-spacing: 1rpx;
}

/* 取消导航按钮（导航卡片底部 — 已弃用，保留为兼容）*/
.nav-cancel {
  font-size: 24rpx;
  color: #e53e3e;
  padding: 10rpx 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(229, 62, 62, 0.25);
  background: rgba(229, 62, 62, 0.04);
}

.nav-cancel:active {
  background: rgba(229, 62, 62, 0.12);
  border-color: rgba(229, 62, 62, 0.5);
}

/* ===== 导航选择弹窗取消 ===== */
.nav-picker-cancel {
  text-align: center;
  margin-top: 24rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #6b7b8d;
}

.nav-picker-cancel:active {
  color: #1a1a2e;
}

/* ================================================================
   装饰动效（保留但适配白色主题）
   ================================================================ */

/* ===== 卡片背景（纯白底，去掉云纹）===== */
.tac-card {
  background: #ffffff;
}

/* ===== 波浪分隔线 ===== */
.wave-divider {
  height: 20rpx;
  margin: 8rpx 0;
  background:
    radial-gradient(circle 10rpx at 10rpx 10rpx, rgba(102, 204, 255, 0.12) 50%, transparent 51%),
    radial-gradient(circle 10rpx at 30rpx 10rpx, rgba(102, 204, 255, 0.08) 50%, transparent 51%),
    radial-gradient(circle 10rpx at 50rpx 10rpx, rgba(102, 204, 255, 0.12) 50%, transparent 51%),
    radial-gradient(circle 10rpx at 70rpx 10rpx, rgba(102, 204, 255, 0.08) 50%, transparent 51%),
    radial-gradient(circle 10rpx at 90rpx 10rpx, rgba(102, 204, 255, 0.12) 50%, transparent 51%);
  background-size: 100rpx 20rpx;
  opacity: 0.6;
}

/* ===== BLE 呼吸灯 ===== */
.ble-dot.on {
  background: #66ccff;
  box-shadow: 0 0 8rpx rgba(102, 204, 255, 0.5);
  animation: tianyi-breathe 2s ease-in-out infinite;
}

@keyframes tianyi-breathe {
  0%, 100% {
    box-shadow: 0 0 8rpx rgba(102, 204, 255, 0.4);
    background: #66ccff;
  }
  50% {
    box-shadow: 0 0 20rpx rgba(102, 204, 255, 0.7), 0 0 40rpx rgba(102, 204, 255, 0.2);
    background: #80d4ff;
  }
}

/* ===== 导航指南针脉冲 ===== */
.map-reset {
  animation: compass-pulse 3s ease-in-out infinite;
}

@keyframes compass-pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(102, 204, 255, 0);
    border-color: rgba(102, 204, 255, 0.35);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(102, 204, 255, 0.08);
    border-color: rgba(102, 204, 255, 0.6);
  }
}

/* ===== 在线状态呼吸 ===== */
.status-dot.online {
  background: #38a169;
  box-shadow: 0 0 6rpx rgba(56, 161, 105, 0.4);
  animation: status-breathe 2.5s ease-in-out infinite;
}

@keyframes status-breathe {
  0%, 100% { box-shadow: 0 0 6rpx rgba(56, 161, 105, 0.4); }
  50% { box-shadow: 0 0 14rpx rgba(56, 161, 105, 0.7), 0 0 28rpx rgba(56, 161, 105, 0.2); }
}

/* ===== 导航卡片浮动光效 ===== */
.nav-card {
  animation: card-float 4s ease-in-out infinite;
}

@keyframes card-float {
  0%, 100% {
    box-shadow: 0 4rpx 16rpx rgba(102, 204, 255, 0.06);
  }
  50% {
    box-shadow: 0 8rpx 32rpx rgba(102, 204, 255, 0.14), 0 0 60rpx rgba(102, 204, 255, 0.04);
  }
}

/* ===== 地图区域辉光 ===== */
.holo-frame {
  box-shadow:
    0 0 20rpx rgba(102, 204, 255, 0.08),
    0 0 60rpx rgba(102, 204, 255, 0.03);
  animation: holo-glow 5s ease-in-out infinite;
}

@keyframes holo-glow {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(102, 204, 255, 0.08),
      0 0 60rpx rgba(102, 204, 255, 0.03);
  }
  50% {
    box-shadow:
      0 0 30rpx rgba(102, 204, 255, 0.12),
      0 0 80rpx rgba(102, 204, 255, 0.06);
  }
}

/* ===== 标题装饰线 ===== */
.nav-title .deco {
  font-size: 22rpx;
  color: rgba(102, 204, 255, 0.5);
  line-height: 1;
  animation: deco-shimmer 3s ease-in-out infinite;
}

@keyframes deco-shimmer {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; color: rgba(102, 204, 255, 0.8); }
}
