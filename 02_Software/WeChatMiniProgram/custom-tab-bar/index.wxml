<view class="tabbar-container">
  <!-- 骑行中：两个按钮 -->
  <view class="ride-btn-wrap dual" wx:if="{{riding}}">
    <button class="ride-btn end" bindtap="onRideBtn">
      <text class="ride-btn-text">结束骑行</text>
    </button>
    <!-- 导航中 → 取消导航 | 未导航 → 开始导航 -->
    <button class="ride-btn {{isNavigating ? 'cancel-nav' : 'start-nav'}}" bindtap="onNavBtn">
      <text class="ride-btn-text">{{isNavigating ? '取消导航' : '开始导航'}}</text>
    </button>
  </view>
  <!-- 未骑行：单按钮 -->
  <view class="ride-btn-wrap" wx:else>
    <button class="ride-btn start" bindtap="onRideBtn">
      <text class="ride-btn-text">开始骑行</text>
    </button>
  </view>
  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view class="tab-item {{selected === index ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="pagePath"
          data-index="{{index}}" bindtap="switchTab">
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
