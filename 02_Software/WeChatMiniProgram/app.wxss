/* app.wxss — 全局样式: 白色主题 + #66CCFF 主色调 */

page {
  --bg-primary: #ffffff;
  --bg-card: #f5f8fb;
  --bg-card-hover: #edf2f7;
  --primary: #66ccff;
  --primary-dark: #4db8e6;
  --primary-light: rgba(102, 204, 255, 0.15);
  --primary-glow: rgba(102, 204, 255, 0.25);
  --accent: #33bbee;
  --text-primary: #1a1a2e;
  --text-secondary: #6b7b8d;
  --text-muted: #9aa8b5;
  --border-color: #e2e8f0;
  --border-light: #edf2f7;
  --alarm-red: #e53e3e;
  --sos-red: #c53030;
  --success: #38a169;
  --warning: #dd6b20;

  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 全局按钮重置 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  font-size: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}
