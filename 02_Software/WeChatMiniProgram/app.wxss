/* app.wxss — 全局样式: Tactical Cyan 主题 */

page {
  --bg-primary: #080d17;
  --bg-card: rgba(12, 20, 36, 0.85);
  --primary: #66ccff;
  --primary-dim: rgba(102, 204, 255, 0.3);
  --primary-glow: rgba(102, 204, 255, 0.15);
  --accent: #00ffff;
  --text-primary: #e0f0ff;
  --text-secondary: #5a7a98;
  --alarm-red: #ff2a4d;
  --sos-red: #cc0000;
  --success: #00d4aa;

  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 全局按钮重置 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  font-size: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}
